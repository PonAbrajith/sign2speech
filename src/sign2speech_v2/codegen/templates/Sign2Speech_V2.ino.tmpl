// Sign2Speech V2 - ESP32 glove firmware.
// GENERATED by Sign2Speech V2 Studio (fingerprint @@FINGERPRINT@@). Board: "ESP32 Dev Module".
//
// Hardware (locked by hardware_lock.h):
//   Flex  Thumb D32, Index D35, Middle D34, Ring VN(39), Little VP(36)  - one divider each
//   OLED  SSD1306 on its own I2C bus  (Wire1): SDA D18, SCL D19, address 0x3C or 0x3D
//   MPU   MPU6050 on a separate bus   (Wire) : SDA D22, SCL D21, address 0x68
// No audio hardware: the laptop speaks the recognized gesture (Studio, over USB serial).
//
// Serial (115200 baud):
//   data lines  Flex1..Flex5,AccelX,AccelY,AccelZ,GyroX,GyroY,GyroZ   (raw ADC, g, deg/s) at 50 Hz
//   status      lines starting with '#', e.g. "# GESTURE: HELLO" once per accepted gesture
//   commands    STATUS | I2C | ADC | PING | HOST | SHOW <NAME>[|<sentence>] | UNKNOWN | CLEAR (= Waiting...)
//   The OLED shows only the sentence of an accepted gesture (no gesture name, no label).
//
// Recognition on the ESP32: calibration -> OPEN/BENT (hysteresis) -> finger-pattern
// match against the enabled gesture table -> hold HOLD_SAMPLES frames -> accepted once.
// While the Studio is connected it sends HOST / SHOW <NAME>, and the OLED shows the
// Studio's live result (which also covers gestures created after this firmware was built).

#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#include "config.h"
#include "hardware_lock.h"
#include "gestures.h"

#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
#include "esp32-hal-periman.h"
#define HAVE_PERIMAN 1
#else
#define HAVE_PERIMAN 0
#endif

// ---- Two separate I2C buses ---------------------------------------------------
static_assert(MPU_I2C_PORT == 0 && OLED_I2C_PORT == 1, "MPU6050 uses Wire (port 0), OLED uses Wire1 (port 1)");
TwoWire& mpuWire = Wire;    // I2C port 0: SDA 22 / SCL 21
TwoWire& oledWire = Wire1;  // I2C port 1: SDA 18 / SCL 19
Adafruit_SSD1306 display(OLED_WIDTH, OLED_HEIGHT, &oledWire, -1);

// ---- State ------------------------------------------------------------------------
struct Imu {
  float accel[3];
  float gyro[3];
};

bool g_oledOk = false;
uint8_t g_oledAddr = 0;
bool g_mpuOk = false;
uint8_t g_whoAmI = 0;
char g_mpuError[72] = "not initialized";

uint16_t g_raw[FLEX_COUNT];
uint16_t g_hist[FLEX_COUNT][FLEX_FILTER_WINDOW];
uint32_t g_sum[FLEX_COUNT];
uint8_t g_histCount = 0, g_histNext = 0;
float g_filtered[FLEX_COUNT];
int8_t g_state[FLEX_COUNT] = {-1, -1, -1, -1, -1};  // -1 unknown, 0 OPEN, 1 BENT

int g_candidate = -2;       // -2 none yet, -1 no unique match, >=0 gesture index
uint16_t g_count = 0;
int g_latched = -1;
uint16_t g_away = 0;

bool g_hostMode = false;
uint32_t g_lastHostMs = 0;
char g_cmd[160];   // SHOW <NAME>|<sentence> from the Studio
uint8_t g_cmdLen = 0;
uint32_t g_nextSampleMs = 0, g_nextHeartbeatMs = 0, g_nextMpuRetryMs = 0;

// ---- MPU6050 (register access on mpuWire; no IMU library) -------------------
uint8_t mpuWrite(uint8_t reg, uint8_t value) {
  mpuWire.beginTransmission(MPU_ADDRESS);
  mpuWire.write(reg);
  mpuWire.write(value);
  return mpuWire.endTransmission();
}

uint8_t mpuRead(uint8_t reg, uint8_t* buf, uint8_t len) {
  mpuWire.beginTransmission(MPU_ADDRESS);
  mpuWire.write(reg);
  uint8_t err = mpuWire.endTransmission(false);
  if (err != 0) return err;
  if (mpuWire.requestFrom((uint16_t)MPU_ADDRESS, (size_t)len, true) != len) return 0xFE;
  for (uint8_t i = 0; i < len; i++) buf[i] = (uint8_t)mpuWire.read();
  return 0;
}

bool mpuInit() {
  uint8_t who = 0;
  uint8_t err = mpuRead(0x75, &who, 1);
  if (err != 0) {
    snprintf(g_mpuError, sizeof(g_mpuError), "no answer at 0x%02X on SDA=%d SCL=%d (I2C error %u)", MPU_ADDRESS,
             MPU_SDA_PIN, MPU_SCL_PIN, err);
    return g_mpuOk = false;
  }
  g_whoAmI = who;
  const uint8_t init[][2] = {{0x6B, 0x01}, {0x1A, 0x03}, {0x19, 4}, {0x1B, 0x00}, {0x1C, 0x00}};
  for (auto& s : init) {
    if ((err = mpuWrite(s[0], s[1])) != 0) {
      snprintf(g_mpuError, sizeof(g_mpuError), "config write failed (I2C error %u)", err);
      return g_mpuOk = false;
    }
  }
  delay(20);
  // WHO_AM_I alone is not the test (this glove's module reports 0x70): the device
  // counts as working when its accelerometer/gyro registers can really be read.
  uint8_t data[14];
  if ((err = mpuRead(0x3B, data, sizeof(data))) != 0) {
    snprintf(g_mpuError, sizeof(g_mpuError), "data registers unreadable (I2C error %u)", err);
    return g_mpuOk = false;
  }
  bool allOnes = true;
  for (uint8_t b : data) allOnes = allOnes && b == 0xFF;
  if (allOnes) {
    snprintf(g_mpuError, sizeof(g_mpuError), "data registers read 0xFF: check SDA/SCL wiring");
    return g_mpuOk = false;
  }
  g_mpuError[0] = '\0';
  return g_mpuOk = true;
}

bool mpuSample(Imu& out) {
  uint8_t d[14];
  if (!g_mpuOk || mpuRead(0x3B, d, sizeof(d)) != 0) {
    if (g_mpuOk) {
      g_mpuOk = false;
      snprintf(g_mpuError, sizeof(g_mpuError), "read failed");
      Serial.println("# MPU6050: ERROR read failed");
    }
    for (int i = 0; i < 3; i++) out.accel[i] = out.gyro[i] = 0.0f;  // reported as ERROR, not as data
    return false;
  }
  for (int i = 0; i < 3; i++) {
    out.accel[i] = (int16_t)((d[i * 2] << 8) | d[i * 2 + 1]) / 16384.0f;    // +-2 g
    out.gyro[i] = (int16_t)((d[8 + i * 2] << 8) | d[9 + i * 2]) / 131.0f;   // +-250 deg/s
  }
  return true;
}

// ---- OLED (oledWire only) ------------------------------------------------------
bool i2cPresent(TwoWire& bus, uint8_t addr) {
  bus.beginTransmission(addr);
  return bus.endTransmission() == 0;
}

void oledText(const char* top, const char* big) {
  if (!g_oledOk) return;
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println(top);
  display.setTextSize(strlen(big) <= 10 ? 2 : 1);
  display.setCursor(0, 24);
  display.println(big);
  display.display();
}

#define OLED_CHARS 21      // text size 1: 6 px per character on 128 px
#define OLED_WRAP_CHARS 16 // text size 1: preferred line width for readable sentences
#define OLED_BIG_CHARS 10  // text size 2: 12 px per character
#define OLED_LINES 8       // text size 1: 8 px per line on 64 px

// Word-wraps `p` into lines of at most `width` characters, breaking inside a word only when that word
// alone is longer than a line. Returns the line count; when `lines` is non-null, line i (of the first
// OLED_LINES) is written to lines + i * (OLED_CHARS + 1).
uint8_t wrapText(const char* p, size_t width, char* lines) {
  uint8_t n = 0;
  while (*p) {
    while (*p == ' ') p++;
    if (!*p) break;
    size_t take = strlen(p);
    if (take > width) {  // break at the last space within `width` characters
      size_t cut = width;
      while (cut > 0 && p[cut] != ' ') cut--;
      take = cut > 0 ? cut : width;
    }
    size_t len = take;
    while (len > 0 && p[len - 1] == ' ') len--;
    if (lines && n < OLED_LINES) {
      char* line = lines + n * (OLED_CHARS + 1);
      memcpy(line, p, len);
      line[len] = '\0';
    }
    n++;
    p += take;
  }
  return n;
}

// Draws `text` alone, centred - text size 2 when it fits on one line, else text size 1 word-wrapped
// to the 128x64 screen with balanced lines ("Please give me" / "some water."). No label, no prefix.
// Lines prefer OLED_WRAP_CHARS; they widen (up to OLED_CHARS) for a longer word or a text that would
// not fit on OLED_LINES lines.
void oledCentered(const char* text) {
  if (!g_oledOk) return;
  const bool big = strlen(text) <= OLED_BIG_CHARS;
  size_t longest = 0;  // longest word: never narrow the lines below it (would split the word)
  for (const char* w = text; *w;) {
    size_t n = strcspn(w, " ");
    longest = n > longest ? n : longest;
    w += n;
    w += strspn(w, " ");
  }
  size_t width = big ? OLED_BIG_CHARS : OLED_WRAP_CHARS;
  if (!big && (longest > width || wrapText(text, width, nullptr) > OLED_LINES)) width = OLED_CHARS;
  const uint8_t count = wrapText(text, width, nullptr);
  while (width > longest && width > 1 && wrapText(text, width - 1, nullptr) == count) width--;
  char lines[OLED_LINES * (OLED_CHARS + 1)];
  wrapText(text, width, lines);
  const uint8_t shown = count < OLED_LINES ? count : OLED_LINES;  // a longer text is cut after line 8
  const int lineH = big ? 16 : (shown <= 6 ? 10 : 8);
  const int top = (OLED_HEIGHT - shown * lineH) / 2;
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(big ? 2 : 1);
  for (uint8_t i = 0; i < shown; i++) {
    const char* line = lines + i * (OLED_CHARS + 1);
    const int textW = (int)strlen(line) * (big ? 12 : 6);
    display.setCursor(textW < OLED_WIDTH ? (OLED_WIDTH - textW) / 2 : 0, top + i * lineH);
    display.println(line);
  }
  display.display();
}

// What the OLED shows: Waiting... (no data / no recognition yet), Unknown (real hand shape that
// matches no gesture, held HOLD_SAMPLES frames) or the accepted gesture's mapped sentence - only the
// sentence itself, never the gesture name or a "Gesture:" label.
enum OledShown { OLED_OTHER, OLED_WAITING, OLED_UNKNOWN };
OledShown g_oledShown = OLED_OTHER;

void oledIdle() {  // Waiting...
  if (g_oledShown == OLED_WAITING) return;
  g_oledShown = OLED_WAITING;
  oledCentered("Waiting...");
}

void oledUnknown() {
  if (g_oledShown == OLED_UNKNOWN) return;
  g_oledShown = OLED_UNKNOWN;
  oledCentered("Unknown");
}

// An accepted gesture: only its mapped sentence (the name only if it has no sentence).
void oledGesture(const char* name, const char* text = "") {
  g_oledShown = OLED_OTHER;
  oledCentered(text && *text ? text : name);
}

bool oledInit() {
  g_oledAddr = 0;
  if (i2cPresent(oledWire, OLED_ADDR_PRIMARY)) g_oledAddr = OLED_ADDR_PRIMARY;
  else if (i2cPresent(oledWire, OLED_ADDR_SECONDARY)) g_oledAddr = OLED_ADDR_SECONDARY;
  if (g_oledAddr == 0) return g_oledOk = false;
  // periphBegin=false: oledWire was already started on SDA 18 / SCL 19.
  g_oledOk = display.begin(SSD1306_SWITCHCAPVCC, g_oledAddr, true, false);
  if (g_oledOk) oledText(FIRMWARE_NAME, "Ready");
  return g_oledOk;
}

// ---- Flex sensors -----------------------------------------------------------------
bool adcAttached(uint8_t pin) {
#if HAVE_PERIMAN
  return perimanGetPinBusType(pin) == ESP32_BUS_TYPE_ADC_ONESHOT;
#else
  (void)pin;
  return true;
#endif
}

void readFlex() {
  for (uint8_t i = 0; i < FLEX_COUNT; i++) {
    uint32_t s = 0;
    for (uint8_t n = 0; n < FLEX_OVERSAMPLE; n++) s += analogRead(FLEX_PINS[i]);
    g_raw[i] = (uint16_t)(s / FLEX_OVERSAMPLE);
    if (g_histCount == FLEX_FILTER_WINDOW) g_sum[i] -= g_hist[i][g_histNext];
    g_hist[i][g_histNext] = g_raw[i];
    g_sum[i] += g_raw[i];
  }
  if (g_histCount < FLEX_FILTER_WINDOW) g_histCount++;
  g_histNext = (uint8_t)((g_histNext + 1) % FLEX_FILTER_WINDOW);
  for (uint8_t i = 0; i < FLEX_COUNT; i++) g_filtered[i] = (float)g_sum[i] / g_histCount;
}

// ---- Recognition ------------------------------------------------------------------
void updateFingerStates() {
  for (uint8_t i = 0; i < FLEX_COUNT; i++) {
    const float span = (float)(CAL_CLOSED[i] - CAL_OPEN[i]);
    float f = span == 0 ? 0.0f : (g_filtered[i] - CAL_OPEN[i]) / span;
    f = f < 0 ? 0 : (f > 1 ? 1 : f);
    if (g_state[i] == 1) g_state[i] = f < BEND_THRESHOLD - BEND_HYSTERESIS ? 0 : 1;
    else if (g_state[i] == 0) g_state[i] = f > BEND_THRESHOLD + BEND_HYSTERESIS ? 1 : 0;
    else g_state[i] = f >= BEND_THRESHOLD ? 1 : 0;
  }
}

bool patternMatches(const char* p) {
  for (uint8_t i = 0; i < FLEX_COUNT; i++) {
    if (p[i] == 'X') continue;
    if ((p[i] == 'B') != (g_state[i] == 1)) return false;
  }
  return true;
}

int matchGesture() {  // index of the unique match, -1 for none or ambiguous
  int found = -1;
  for (int g = 0; g < GESTURE_COUNT; g++) {
    if (patternMatches(GESTURES[g].pattern)) {
      if (found >= 0) return -1;  // AMBIGUOUS: never guess
      found = g;
    }
  }
  return found;
}

void recognitionStep() {
#if CALIBRATED
  if (GESTURE_COUNT == 0) return;
  updateFingerStates();
  const int m = matchGesture();
  if (g_latched >= 0) {
    if (m == g_latched) {
      g_away = 0;
      return;
    }
    if (++g_away < RELEASE_SAMPLES) return;
    g_latched = -1;
    g_away = 0;
    g_candidate = -2;
    g_count = 0;
  }
  if (m == g_candidate) {
    if (g_count < 0xFFFF) g_count++;
  } else {
    g_candidate = m;
    g_count = 1;
  }
  if (m < 0 && g_count >= HOLD_SAMPLES) {
    if (!g_hostMode) oledUnknown();  // stable real hand shape that matches no gesture (or is ambiguous)
  } else if (m >= 0 && g_count >= HOLD_SAMPLES) {
    g_latched = m;
    g_away = 0;
    Serial.printf("# GESTURE: %s\n", GESTURES[m].name);  // once per acceptance
    if (!g_hostMode) oledGesture(GESTURES[m].name, GESTURES[m].text);
  }
#endif
}

// ---- Diagnostics ------------------------------------------------------------------
void printI2cScan(const char* label, TwoWire& bus, int sda, int scl) {
  Serial.printf("# I2C %s: SDA=%d SCL=%d found", label, sda, scl);
  int n = 0;
  for (uint8_t a = 1; a < 127; a++) {
    if (i2cPresent(bus, a)) {
      Serial.printf(" 0x%02X", a);
      n++;
    }
  }
  Serial.println(n ? "" : " none");
}

void printFlexStatus() {
  readFlex();
  bool allZero = true;
  for (uint8_t i = 0; i < FLEX_COUNT; i++) allZero = allZero && g_raw[i] <= 5;
  Serial.printf("# FLEX: %s raw=%u,%u,%u,%u,%u\n", allZero ? "ERROR ALL ADC = 0 - CHECK FLEX WIRING" : "OK",
                g_raw[0], g_raw[1], g_raw[2], g_raw[3], g_raw[4]);
}

void printStatus() {
  Serial.printf("# FIRMWARE: %s %s\n", FIRMWARE_NAME, FIRMWARE_FINGERPRINT);
  Serial.printf("# ESP32: OK chip=%s rev=%d cpu=%luMHz\n", ESP.getChipModel(), ESP.getChipRevision(),
                (unsigned long)getCpuFrequencyMhz());
  Serial.printf("# PINS: FLEX=%d,%d,%d,%d,%d OLED_SDA=%d OLED_SCL=%d MPU_SDA=%d MPU_SCL=%d\n", FLEX_PINS[0],
                FLEX_PINS[1], FLEX_PINS[2], FLEX_PINS[3], FLEX_PINS[4], OLED_SDA_PIN, OLED_SCL_PIN, MPU_SDA_PIN,
                MPU_SCL_PIN);
  printFlexStatus();
  if (g_mpuOk) {
    Serial.printf("# MPU6050: OK addr=0x%02X WHO_AM_I=0x%02X%s\n", MPU_ADDRESS, g_whoAmI,
                  g_whoAmI == 0x68 ? "" : " compatible");
  } else {
    Serial.printf("# MPU6050: ERROR %s\n", g_mpuError);
  }
  if (g_oledOk) {
    Serial.printf("# OLED: OK addr=0x%02X\n", g_oledAddr);
  } else {
    Serial.printf("# OLED: ERROR not detected (scanned 0x3C 0x3D on SDA=%d SCL=%d)\n", OLED_SDA_PIN, OLED_SCL_PIN);
  }
  Serial.printf("# GESTURES: %d\n", GESTURE_COUNT);
#if CALIBRATED
  Serial.println("# RECOGNITION: FINGER_PATTERN");
#else
  Serial.println("# RECOGNITION: DISABLED not calibrated (calibrate in the Studio, then regenerate)");
#endif
  Serial.printf("# STREAM: %d Hz accel=g gyro=deg/s\n", 1000 / SAMPLE_PERIOD_MS);
  Serial.println("# READY");
}

void adcTest() {
  const uint16_t samples = 32;
  Serial.printf("# ADC TEST: samples=%u interval_us=500\n", samples);
  for (uint8_t f = 0; f < FLEX_COUNT; f++) {
    const uint8_t pin = FLEX_PINS[f];
    uint32_t sum = 0, steps = 0;
    uint16_t lo = 0xFFFF, hi = 0, prev = 0;
    for (uint16_t n = 0; n < samples; n++) {
      const uint16_t v = analogRead(pin);
      sum += v;
      if (n) steps += v > prev ? v - prev : prev - v;
      prev = v;
      lo = v < lo ? v : lo;
      hi = v > hi ? v : hi;
      delayMicroseconds(500);
    }
    Serial.printf("# ADC %s GPIO%u samples=%u min=%u max=%u avg=%lu step=%lu mv=%lu driver=%s\n", FINGER_NAMES[f],
                  pin, samples, lo, hi, (unsigned long)((sum + samples / 2) / samples),
                  (unsigned long)((steps + (samples - 1) / 2) / (samples - 1)),
                  (unsigned long)analogReadMilliVolts(pin), adcAttached(pin) ? "ATTACHED" : "NOT_ATTACHED");
  }
  Serial.println("# ADC END");
}

// ---- Commands -----------------------------------------------------------------------
void handleCommand(char* cmd) {
  while (*cmd == ' ') cmd++;
  for (char* p = cmd + strlen(cmd); p > cmd && (p[-1] == ' ' || p[-1] == '\r'); *--p = '\0') {}
  if (!*cmd) return;
  if (!strcasecmp(cmd, "STATUS")) {
    printStatus();
  } else if (!strcasecmp(cmd, "I2C")) {
    printI2cScan("OLED", oledWire, OLED_SDA_PIN, OLED_SCL_PIN);
    printI2cScan("MPU", mpuWire, MPU_SDA_PIN, MPU_SCL_PIN);
  } else if (!strcasecmp(cmd, "ADC")) {
    adcTest();
  } else if (!strcasecmp(cmd, "PING")) {
    Serial.println("# PONG");
  } else if (!strcasecmp(cmd, "HOST")) {
    g_hostMode = true;
    g_lastHostMs = millis();
  } else if (!strncasecmp(cmd, "SHOW ", 5)) {  // SHOW <NAME>[|<sentence>]
    g_hostMode = true;
    g_lastHostMs = millis();
    char* name = cmd + 5;
    char* text = strchr(name, '|');
    if (text) *text++ = '\0';
    oledGesture(name, text ? text : "");
    Serial.printf("# OLED SHOW: %s%s\n", name, g_oledOk ? "" : " (OLED not detected)");
  } else if (!strcasecmp(cmd, "CLEAR")) {  // Studio: no live data -> Waiting...
    g_lastHostMs = millis();
    oledIdle();
  } else if (!strcasecmp(cmd, "UNKNOWN")) {  // Studio: live data matches no gesture
    g_hostMode = true;
    g_lastHostMs = millis();
    oledUnknown();
  } else {
    Serial.printf("# ERR unknown command '%s'\n", cmd);
  }
}

void pollCommands() {
  while (Serial.available()) {
    const char c = (char)Serial.read();
    if (c == '\n') {
      g_cmd[g_cmdLen] = '\0';
      handleCommand(g_cmd);
      g_cmdLen = 0;
    } else if (g_cmdLen < sizeof(g_cmd) - 1) {
      g_cmd[g_cmdLen++] = c;
    }
  }
}

// ---- Arduino entry points ---------------------------------------------------------
void setup() {
  Serial.begin(SERIAL_BAUD);
  delay(300);
  analogReadResolution(12);
  for (uint8_t i = 0; i < FLEX_COUNT; i++) {
    analogRead(FLEX_PINS[i]);                         // attaches the ADC channel
    analogSetPinAttenuation(FLEX_PINS[i], ADC_11db);  // ~0-3.1 V
  }
  mpuWire.begin(MPU_SDA_PIN, MPU_SCL_PIN, I2C_CLOCK_HZ);
  oledWire.begin(OLED_SDA_PIN, OLED_SCL_PIN, I2C_CLOCK_HZ);
  delay(50);
  mpuInit();
  oledInit();
  printStatus();
  if (g_oledOk) oledIdle();
  g_nextSampleMs = millis();
  g_nextHeartbeatMs = millis() + HEARTBEAT_MS;
}

void loop() {
  pollCommands();
  const uint32_t now = millis();
  if (g_hostMode && now - g_lastHostMs > HOST_TIMEOUT_MS) {
    g_hostMode = false;  // Studio gone: OLED shows on-device recognition again
    if (g_latched >= 0) oledGesture(GESTURES[g_latched].name, GESTURES[g_latched].text);
    else oledIdle();
  }
  if (!g_mpuOk && (int32_t)(now - g_nextMpuRetryMs) >= 0) {
    g_nextMpuRetryMs = now + 2000;
    if (mpuInit()) Serial.printf("# MPU6050: OK addr=0x%02X WHO_AM_I=0x%02X\n", MPU_ADDRESS, g_whoAmI);
  }
  if ((int32_t)(now - g_nextSampleMs) >= 0) {
    g_nextSampleMs += SAMPLE_PERIOD_MS;
    if ((int32_t)(now - g_nextSampleMs) > 5 * SAMPLE_PERIOD_MS) g_nextSampleMs = now + SAMPLE_PERIOD_MS;
    readFlex();
    Imu imu;
    mpuSample(imu);
    Serial.printf("%u,%u,%u,%u,%u,%.3f,%.3f,%.3f,%.2f,%.2f,%.2f\n", g_raw[0], g_raw[1], g_raw[2], g_raw[3],
                  g_raw[4], imu.accel[0], imu.accel[1], imu.accel[2], imu.gyro[0], imu.gyro[1], imu.gyro[2]);
    recognitionStep();
  }
  if ((int32_t)(now - g_nextHeartbeatMs) >= 0) {
    g_nextHeartbeatMs = now + HEARTBEAT_MS;
    Serial.printf("# STATUS MPU6050=%s OLED=%s HOST=%d UPTIME=%lu\n", g_mpuOk ? "OK" : "ERROR",
                  g_oledOk ? "OK" : "ERROR", g_hostMode ? 1 : 0, (unsigned long)(now / 1000));
  }
}
